/-- WTA reopening threshold. Follows the user-locked normalization
`D ≥ 2(1−α)/(9α)` per `source_proof.md` and `lean_state.md`; a competing
normalization `D ≥ 9α/(2(1−α))` flagged in `v9_consolidated.md` is being
adjudicated in the decomposition reviewer pass. -/
theorem «Hall-WTA-reopening-threshold-D»
    (α D : ℝ) (hα_pos : 0 < α) (_hα_lt : α < 1) :
    ((-2 * α * D + (1 - α) * ((4 : ℝ) / 9) ≤ 0)
      ↔ ((2 * (1 - α)) / (9 * α) ≤ D)) := by
  have h9α : (0 : ℝ) < 9 * α := by positivity
  rw [div_le_iff₀ h9α]
  constructor
  · intro h; nlinarith
  · intro h; nlinarith

