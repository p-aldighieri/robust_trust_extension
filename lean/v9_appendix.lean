namespace Inventory

open MeasureTheory ProbabilityTheory

/-! ## New v9 Inventory axioms (added 2026-05-21) -/

/-- Abstract Clarke subdifferential placeholder (Clarke 1990 §2.5). -/
opaque ClarkeSubdiff
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] :
    (E → ℝ) → E → Set E

/-- Abstract Clarke normal cone placeholder (Clarke 1990 §2.4). -/
opaque ClarkeNormalCone
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] :
    Set E → E → Set E

structure ClarkeDanskinHyp
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (_F : E → ℝ) (_x : E) (_Candidates : Set E) where
  locallyLipschitz : Prop
  compactActiveSet : Prop
  danskinRepresentation : Prop

/-- **Clarke–Danskin stationarity.** Clarke subdifferential of an integral /
Danskin's theorem applied to a value functional. Source: Clarke 1990, *Optimization
and Nonsmooth Analysis*, §2.7; Danskin envelope theorem. -/
axiom clarke_danskin_stationarity
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (F : E → ℝ) (x : E) (Candidates : Set E)
    (h : ClarkeDanskinHyp F x Candidates) :
    ∃ ξ ∈ Candidates, ξ ∈ ClarkeSubdiff F x

/-- **Clarke–Fermat normal-cone stationarity.** Clarke subdifferential at a local
extremum is contained in the normal cone. Source: Clarke 1990, Fermat rule for
locally Lipschitz functions constrained to a closed set. -/
axiom clarke_fermat_normal_cone
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (F : E → ℝ) (C : Set E) (x : E)
    (_hx : x ∈ C)
    (_hLocalMax : Prop)
    (ξ : E)
    (_hξ : ξ ∈ ClarkeSubdiff F x) :
    -ξ ∈ ClarkeNormalCone C x

structure StrassenMarginalDominance
    {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    (_μ : Measure α) (_ν : Measure β) (_R : Set (α × β)) where
  dualInequality : Prop

/-- **Strassen marginals theorem (1965).** Coupling existence under marginal
dominance / Kantorovich–Rubinstein duality form. Source: Strassen 1965,
*The existence of probability measures with given marginals*, Ann. Math. Stat. -/
axiom strassen_marginals
    {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    (μ : Measure α) (ν : Measure β) (R : Set (α × β))
    (_h : StrassenMarginalDominance μ ν R) :
    ∃ π : Measure (α × β),
      (Measure.map Prod.fst π = μ) ∧
      (Measure.map Prod.snd π = ν) ∧
      π Rᶜ = 0

structure ConicFarkasInstance : Type where
  primalFeasible : Prop
  dualNonpositive : Prop

/-- **Farkas / strong conic LP duality.** Used for finite cone-Hall (G1) and
the polyhedral LP threshold (G4). Source: Farkas lemma; finite-dimensional
conic strong duality (Boyd–Vandenberghe §5). -/
axiom farkas_lp_duality_conic
    (inst : ConicFarkasInstance) :
    inst.primalFeasible ↔ inst.dualNonpositive

structure BergeMaximumHyp
    {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    (_F : X → Set Y) (_f : X → Y → ℝ) where
  compactValues : Prop
  closedGraph : Prop
  continuousObjective : Prop

/-- **Berge maximum theorem (set-valued).** Audit task: many uses may be
dischargeable from Mathlib's existing compactness/continuity. Source:
Aliprantis–Border §17. -/
axiom berge_maximum_set_valued
    {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    (_F : X → Set Y) (_f : X → Y → ℝ)
    (_h : BergeMaximumHyp _F _f) :
    Prop

/-- **Hausdorff–Alexandroff continuous surjection.** Every nonempty compact
metric space is a continuous image of the Cantor space. Source: Kechris 1995,
*Classical Descriptive Set Theory*, Thm 4.18; or any standard descriptive
set theory text. -/
axiom hausdorff_alexandroff_continuous_surjection
    (K : Type*) [TopologicalSpace K] [CompactSpace K] [T2Space K]
    [SecondCountableTopology K] :
    Prop  -- placeholder until CantorSpace is fixed in Mathlib

end Inventory

